<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkApplicationWindow" id="main_window">
    <style>
        <class name="vbox"/>
    </style>
    <property name="decorated">false</property>
    <property name="resizable">false</property>
    <property name="can-focus">false</property>
    <child>
      <object class="GtkBox" id="root">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <property name="margin-top">8</property>
        <property name="margin-bottom">8</property>

        <!-- SECTION: SYSTEM -->
        <child>
          <object class="GtkBox" id="section_SYSTEM">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_SYSTEM">
                <property name="label"> SYSTEM </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- SECTION: FILESYSTEMS -->
        <child>
          <object class="GtkBox" id="section_FILESYSTEMS">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_FILESYSTEMS">
                <property name="label"> FILESYSTEMS </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- SECTION: NETWORKING -->
        <child>
          <object class="GtkBox" id="section_NETWORKING">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_NETWORKING">
                <property name="label"> NETWORKING </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- SECTION: GPU -->
        <child>
          <object class="GtkBox" id="section_GPU">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_GPU">
                <property name="label"> GPU </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- SECTION: Temperature -->
        <child>
          <object class="GtkBox" id="section_Temperature">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_Temperature">
                <property name="label"> Temperature </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- SECTION: Power -->
        <child>
          <object class="GtkBox" id="section_Power">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_Power">
                <property name="label"> Power </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- SECTION: Clocks -->
        <child>
          <object class="GtkBox" id="section_Clocks">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_Clocks">
                <property name="label"> Clocks </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- SECTION: Misc -->
        <child>
          <object class="GtkBox" id="section_Misc">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="hdr_Misc">
                <property name="label"> Misc </property>
                <property name="halign">start</property>
                <style><class name="section-header"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- Bottom controls (stay in root) -->
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Snow </property>
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <style><class name="row-label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkSwitch" id="snow_switch">
                <property name="halign">end</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Dock Lock </property>
                <property name="halign">start</property>
                <property name="hexpand">true</property>
                <style><class name="row-label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkSwitch" id="detach_lock_switch">
                <property name="halign">end</property>
              </object>
            </child>
          </object>
        </child>
      </object>

    </child>
  </object>
</interface>
